(in-package #:highlight-protocol/tests)

;;; Common Lisp and its dialects.

(deftest lisp-defun
  (ok (equal '((:punctuation . "(") (:keyword . "defun") (:plain . " ") (:function . "foo")
               (:plain . " ") (:punctuation . "(") (:plain . "x") (:punctuation . ")")
               (:plain . " ") (:doc . "\"Doc.\"") (:plain . " ") (:punctuation . "(")
               (:builtin . "car") (:plain . " x") (:punctuation . "))") (:plain . " ")
               (:comment . "; hi"))
             (toks "lisp" "(defun foo (x) \"Doc.\" (car x)) ; hi"))))

(deftest lisp-literals
  (ok (equal '((:punctuation . "(") (:keyword . "let") (:plain . " ") (:punctuation . "((")
               (:plain . "n ") (:number . "1.5d0") (:punctuation . "))") (:plain . " ")
               (:punctuation . "(") (:builtin . "format") (:plain . " ") (:constant . "t")
               (:plain . " ") (:string . "\"~a\"") (:plain . " ") (:symbol . ":key")
               (:plain . " ") (:symbol . "'sym") (:plain . " ") (:function . "#'car")
               (:plain . " ") (:variable . "*x*") (:plain . " ") (:constant . "+y+")
               (:plain . " ") (:string . "#\\a") (:punctuation . "))"))
             (toks "lisp" "(let ((n 1.5d0)) (format t \"~a\" :key 'sym #'car *x* +y+ #\\a))"))))

(deftest-parametrize lisp-numbers
    ((text)
     "1" "-42" "+7" "3." "1/2" "-3/4" "1.5" ".5" "-.5e3" "1e10" "2.0d0" "6.02E+23"
     "#x1F" "#b1010" "#o17" "#36rZZ" "#*1011")
  (ok (equal (list (cons :number text)) (tokenize text "lisp"))))

(deftest-parametrize lisp-not-numbers
    ((text)
     "1+" "-" "+" "1-" "..." "a1" "1a" "/" "1/")
  (ok (eq :plain (car (first (tokenize text "lisp"))))))

(deftest lisp-reader-macros
  (ok (equal '((:comment . "#| a #| b |# c |#") (:plain . " ") (:meta . "#+sbcl") (:plain . " ")
               (:punctuation . "(") (:plain . "x") (:punctuation . ")") (:plain . " ")
               (:number . "#x1F") (:plain . " ") (:meta . "`") (:punctuation . "(")
               (:plain . "a ") (:meta . ",") (:plain . "b ") (:meta . ",@") (:plain . "c")
               (:punctuation . ")"))
             (toks "lisp" "#| a #| b |# c |# #+sbcl (x) #x1F `(a ,b ,@c)")))
  (ok (equal '((:symbol . "#:foo") (:plain . " ") (:meta . "#.") (:punctuation . "(")
               (:builtin . "+") (:plain . " ") (:number . "1") (:plain . " ") (:number . "2")
               (:punctuation . ")") (:plain . " ") (:meta . "#p") (:string . "\"/tmp\""))
             (toks "lisp" "#:foo #.(+ 1 2) #p\"/tmp\"")))
  (ok (equal '((:string . "#\\Space") (:plain . " ") (:string . "#\\(") (:plain . " ")
               (:string . "#\\)"))
             (toks "lisp" "#\\Space #\\( #\\)"))
      "#\\( and #\\) are characters, not parentheses")
  (ok (equal '((:meta . "#1=") (:punctuation . "(") (:plain . "a ") (:meta . "#1#")
               (:punctuation . ")"))
             (toks "lisp" "#1=(a #1#)")))
  (ok (equal '((:punctuation . "#(") (:plain . "if ") (:number . "1") (:punctuation . ")"))
             (toks "lisp" "#(if 1)"))
      "a vector is data")
  (ok (equal '((:meta . "#-") (:punctuation . "(") (:plain . "or sbcl ccl")
               (:punctuation . ")") (:plain . " ") (:punctuation . "(") (:builtin . "car")
               (:punctuation . ")"))
             (toks "lisp" "#-(or sbcl ccl) (car)"))
      "a feature expression is data"))

(deftest lisp-quote-is-data
  (ok (equal '((:meta . "'") (:punctuation . "(") (:plain . "if a b") (:punctuation . ")"))
             (toks "lisp" "'(if a b)")))
  (ok (eq :keyword (class-of-piece (toks "lisp" "(if a b)") "if")))
  (ok (eq :keyword (class-of-piece (toks "lisp" "`(if ,a b)") "if"))
      "a backquote template is code"))

(deftest lisp-operator-position
  (ok (equal '((:punctuation . "(") (:builtin . "list") (:plain . " list") (:punctuation . ")"))
             (toks "lisp" "(list list)"))
      "functions only where they are called")
  (ok (eq :builtin (class-of-piece (toks "lisp" "(cl:car x)") "cl:car")))
  (ok (eq :builtin (class-of-piece (toks "lisp" "(common-lisp::mapcar f x)") "common-lisp::mapcar")))
  (ok (eq :plain (class-of-piece (toks "lisp" "(alexandria:when-let)") "alexandria:when-let")))
  (ok (eq :keyword (class-of-piece (toks "lisp" "(with-foo (x) x)") "with-foo"))
      "with- macros")
  (ok (eq :keyword (class-of-piece (toks "lisp" "(lambda (x &optional y) x)") "lambda")))
  (ok (eq :type (class-of-piece (toks "lisp" "(lambda (x &optional y) x)") "&optional")))
  (ok (equal '((:punctuation . "(") (:keyword . "lambda") (:plain . " ") (:punctuation . "(")
               (:plain . "list") (:punctuation . ")") (:plain . " ") (:doc . "\"L.\"")
               (:plain . " list") (:punctuation . ")"))
             (toks "lisp" "(lambda (list) \"L.\" list)"))
      "a lambda list is data; lambda takes a docstring")
  (ok (eq :plain (class-of-piece (toks "lisp" "(defun f (list count) list)") "list count"))
      "so is a defun's")
  (ok (eq :keyword (class-of-piece (toks "lisp" "(DEFUN F ())") "DEFUN")) "case-insensitive")
  (ok (eq :plain (class-of-piece (toks "lisp" "(default-value)") "default-value"))
      "default… is not a definer"))

(deftest lisp-definitions
  (let ((tokens (toks "lisp" "(defclass point () ((x :documentation \"X.\")) (:documentation \"P.\"))")))
    (ok (eq :keyword (class-of-piece tokens "defclass")))
    (ok (eq :type (class-of-piece tokens "point")))
    (ok (eq :symbol (class-of-piece tokens ":documentation")))
    (ok (eq :doc (class-of-piece tokens "\"X.\"")))
    (ok (eq :doc (class-of-piece tokens "\"P.\""))))
  (let ((tokens (toks "lisp" "(defparameter *n* 10 \"Count.\")")))
    (ok (eq :variable (class-of-piece tokens "*n*")))
    (ok (eq :number (class-of-piece tokens "10")))
    (ok (eq :doc (class-of-piece tokens "\"Count.\""))))
  (ok (eq :string (class-of-piece (toks "lisp" "(defvar *n* \"value\")") "\"value\""))
      "a defvar value is not its documentation")
  (ok (eq :variable (class-of-piece (toks "lisp" "(defconstant limit 10)") "limit")))
  (let ((tokens (toks "lisp" "(defmethod area :around ((s circle)) \"Doc\" (next))")))
    (ok (eq :function (class-of-piece tokens "area")))
    (ok (eq :symbol (class-of-piece tokens ":around")))
    (ok (eq :plain (class-of-piece tokens "s circle")))
    (ok (eq :doc (class-of-piece tokens "\"Doc\""))))
  (ok (eq :string (class-of-piece (toks "lisp" "(defun f () (g \"x\"))") "\"x\""))
      "a string in the body is a string")
  (ok (eq :doc (class-of-piece (toks "lisp" "(defmacro m (&body b) \"M.\" b)") "\"M.\"")))
  (ok (eq :function (class-of-piece (toks "lisp" "(defgeneric area (s))") "area")))
  (ok (eq :type (class-of-piece (toks "lisp" "(define-condition oops (error) ())") "oops")))
  (ok (eq :type (class-of-piece (toks "lisp" "(deftype octet () '(unsigned-byte 8))") "octet")))
  (ok (eq :function (class-of-piece (toks "lisp" "(deftest smoke (ok t))") "smoke"))
      "any def… form names a function")
  (ok (equal '((:punctuation . "(") (:keyword . "defun") (:plain . " ") (:punctuation . "(")
               (:plain . "setf ") (:function . "foo") (:punctuation . ")") (:plain . " ")
               (:punctuation . "(") (:plain . "v x") (:punctuation . ")") (:plain . " v")
               (:punctuation . ")"))
             (toks "lisp" "(defun (setf foo) (v x) v)"))
      "a (setf name) names its second symbol")
  (let ((tokens (toks "lisp" "(defstruct (point (:conc-name p-)) \"A point.\" x)")))
    (ok (eq :type (class-of-piece tokens "point")))
    (ok (eq :doc (class-of-piece tokens "\"A point.\"")))))

(deftest lisp-strings-and-escapes
  (ok (equal '((:string . "\"a\\\"b\"")) (toks "lisp" "\"a\\\"b\"")))
  (ok (equal '((:punctuation . "(") (:plain . "f |a b|") (:punctuation . ")"))
             (toks "lisp" "(f |a b|)"))
      "|…| is part of a symbol")
  (ok (equal '((:plain . "a\\ b")) (toks "lisp" "a\\ b")) "an escaped space")
  (ok (equal '((:string . "\"line one
line two\"")) (toks "lisp" "\"line one" "line two\""))
      "strings span lines"))

(deftest lisp-truncated
  (ok (equal '((:punctuation . "(") (:keyword . "defun") (:plain . " ") (:function . "foo")
               (:plain . " ") (:punctuation . "(") (:plain . "x") (:punctuation . ")")
               (:plain . " ") (:doc . "\"unterminated"))
             (toks "lisp" "(defun foo (x) \"unterminated")))
  (ok (equal '((:comment . "#| open #| nested |# still")) (toks "lisp" "#| open #| nested |# still")))
  (ok (equal '((:plain . "|open")) (toks "lisp" "|open")))
  (ok (equal '((:punctuation . ")))") (:plain . " ") (:punctuation . "(") (:builtin . "car")
               (:punctuation . ")"))
             (toks "lisp" "))) (car)"))
      "stray closers are punctuation")
  (ok (equal '((:meta . "#")) (toks "lisp" "#")))
  (ok (equal '((:string . "#\\")) (toks "lisp" "#\\")))
  (ok (equal '((:meta . "'")) (toks "lisp" "'"))))

(deftest scheme-dialect
  (let ((tokens (toks "scheme" "(define (square x) (* x x)) #t #f [a b] (define pi 3.14) #;(skip)")))
    (ok (eq :keyword (class-of-piece tokens "define")))
    (ok (eq :function (class-of-piece tokens "square")))
    (ok (eq :builtin (class-of-piece tokens "*")))
    (ok (eq :constant (class-of-piece tokens "#t")))
    (ok (eq :constant (class-of-piece tokens "#f")))
    (ok (eq :punctuation (class-of-piece tokens "[")))
    (ok (eq :variable (class-of-piece tokens "pi")))
    (ok (eq :comment (class-of-piece tokens "#;"))))
  (ok (eq :doc (class-of-piece (toks "scheme" "(define (f x) \"Doc.\" x)") "\"Doc.\"")))
  (ok (eq :keyword (class-of-piece (toks "scheme" "(let ([x 1]) (set! x 2))") "set!"))))

(deftest emacs-lisp-dialect
  (let ((tokens (toks "elisp" "(defcustom my-var 1 \"Doc.\" :type 'integer) ?a ?\\n [1 2]")))
    (ok (eq :keyword (class-of-piece tokens "defcustom")))
    (ok (eq :variable (class-of-piece tokens "my-var")))
    (ok (eq :doc (class-of-piece tokens "\"Doc.\"")))
    (ok (eq :symbol (class-of-piece tokens "'integer")))
    (ok (eq :string (class-of-piece tokens "?a")))
    (ok (eq :string (class-of-piece tokens "?\\n")))
    (ok (eq :punctuation (class-of-piece tokens "["))))
  (ok (eq :keyword (class-of-piece (toks "elisp" "(save-excursion (goto-char 1))") "save-excursion")))
  (ok (eq :plain (class-of-piece (toks "lisp" "foo?") "foo?")) "? in a symbol"))
